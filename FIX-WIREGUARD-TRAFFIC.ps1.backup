#Requires -RunAsAdministrator
<#
.SYNOPSIS
    Fix WireGuard traffic blocking issues - diagnose and repair VPN connectivity

.DESCRIPTION
    This script diagnoses and fixes common WireGuard traffic issues:
    - Kill switch blocking VPN interface traffic
    - Missing default route through VPN
    - Firewall rule conflicts
   - DNS enforcement blocking legitimate traffic
    - IPv6 leaks

.NOTES
    Author: ColinNebula - Nebula Media 3D
    Version: 1.0.0
    Last Updated: April 16, 2026
#>

param(
    [switch]$DiagnoseOnly,
    [switch]$FixAll,
    [switch]$RemoveAllRules,
    [switch]$Verbose
)

$ErrorActionPreference = "Continue"

# Colors
function Write-Step  { param($msg) Write-Host "`n[STEP] $msg" -ForegroundColor Cyan }
function Write-OK    { param($msg) Write-Host "  âœ… $msg" -ForegroundColor Green }
function Write-Warn  { param($msg) Write-Host "  âš ï¸  $msg" -ForegroundColor Yellow }
function Write-Error { param($msg) Write-Host "  âŒ $msg" -ForegroundColor Red }
function Write-Info  { param($msg) Write-Host "  â„¹ï¸  $msg" -ForegroundColor Gray }

Write-Host "`nâ•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—" -ForegroundColor Cyan
Write-Host "â•‘     WIREGUARD TRAFFIC FIX - Diagnostic & Repair Tool   â•‘" -ForegroundColor Cyan  
Write-Host "â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•`n" -ForegroundColor Cyan

# Check admin
$isAdmin = ([Security.Principal.WindowsPrincipal] [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $isAdmin) {
    Write-Error "Must run as Administrator!"
    Write-Info "Right-click PowerShell â†’ Run as Administrator"
    Read-Host "Press Enter to exit"
    exit 1
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STEP 1: Detect WireGuard Adapter
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Step "Detecting WireGuard adapter..."

$vpnAdapter = Get-NetAdapter | Where-Object {
    ($_.InterfaceDescription -like "*WireGuard*") -or
    ($_.Name -like "*Nebula*") -or
    ($_.Name -eq "Nebulavpn")
} | Select-Object -First 1

if (-not $vpnAdapter) {
    Write-Error "WireGuard adapter not found!"
    Write-Info "Make sure VPN is connected first"
    Write-Info "Try running: Get-NetAdapter | Where-Object Status -eq 'Up'"
    Read-Host "Press Enter to exit"
    exit 1
}

Write-OK "Found VPN adapter: $($vpnAdapter.Name) ($($vpnAdapter.Status))"
$vpnIndex = $vpnAdapter.InterfaceIndex
$vpnName = $vpnAdapter.Name

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STEP 2: Diagnose Firewall Rules
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Step "Diagnosing firewall rules..."

# Initialize fix flags
$needsInterfaceFix = $false
$needsRoutingFix = $false

$nebulaRules = Get-NetFirewallRule | Where-Object {
    $_.DisplayName -like "*Nebula*" -or $_.Name -like "*NebulaVPN*"
}

Write-Info "Found $($nebulaRules.Count) Nebula VPN firewall rules"

# Check for blocking rules
$blockAllRule = $nebulaRules | Where-Object {
    $_.Name -like "*BlockAll*" -and $_.Action -eq "Block"
}

if ($blockAllRule) {
    Write-Warn "Kill switch 'Block All' rule is active"
    Write-Info "This blocks ALL traffic by default"
}

# Check for interface allow rule
$allowInterfaceRule = $nebulaRules | Where-Object {
    ($_.Name -like "*AllowInterface*" -or $_.Name -like "*AllowVPNNet*") -and
    $_.Action -eq "Allow"
}

if (-not $allowInterfaceRule) {
    Write-Error "MISSING: Firewall rule to allow traffic through VPN interface!"
    Write-Info "This is the main cause of traffic blocking"
    $needsInterfaceFix = $true
} else {
    Write-OK "Interface allow rule exists: $($allowInterfaceRule.Name)"
    $needsInterfaceFix = $false
}

# Check DNS rules
$dnsRules = $nebulaRules | Where-Object {
    $_.Name -like "*DNS*"
}

if ($dnsRules) {
    Write-Info "Found $($dnsRules.Count) DNS-related rules"
    foreach ($rule in $dnsRules) {
        Write-Info "  - $($rule.Name): $($rule.Action) (Enabled: $($rule.Enabled))"
    }
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STEP 3: Check Routing Table
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Step "Checking routing table..."

$routes = route print | Out-String

# Check for default route through VPN
$defaultRouteVPN = Get-NetRoute -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | 
    Where-Object { $_.InterfaceIndex -eq $vpnIndex }

if ($defaultRouteVPN) {
    Write-OK "Default route points to VPN interface"
} else {
    Write-Warn "No default route through VPN interface"
    Write-Info "Traffic may not be using the VPN tunnel"
    $needsRoutingFix = $true
}

# Check for physical gateway route
$physicalGateway = (Get-NetRoute -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | 
    Where-Object { $_.InterfaceIndex -ne $vpnIndex } |
    Select-Object -First 1).NextHop

if ($physicalGateway) {
    Write-OK "Physical gateway detected: $physicalGateway"
} else {
    Write-Warn "Could not detect physical gateway"
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STEP 4: Check DNS Configuration
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Step "Checking DNS configuration..."

$vpnDNS = Get-DnsClientServerAddress -InterfaceIndex $vpnIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue

if ($vpnDNS -and $vpnDNS.ServerAddresses) {
    Write-OK "VPN DNS servers: $($vpnDNS.ServerAddresses -join ', ')"
} else {
    Write-Warn "No DNS servers configured on VPN interface"
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# STEP 5: Check Interface Status
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Step "Checking interface status..."

if ($vpnAdapter.Status -eq "Up") {
    Write-OK "VPN interface is UP"
} else {
    Write-Error "VPN interface is $($vpnAdapter.Status)"
    Write-Info "VPN may not be connected properly"
}

# Check for IP address assignment
$vpnIP = Get-NetIPAddress -InterfaceIndex $vpnIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue

if ($vpnIP) {
    Write-OK "VPN IP address: $($vpnIP.IPAddress)"
} else {
    Write-Error "No IP address assigned to VPN interface"
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# SUMMARY & FIX OPTIONS
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Host "`nâ•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—" -ForegroundColor Yellow
Write-Host "â•‘                    DIAGNOSIS SUMMARY                    â•‘" -ForegroundColor Yellow
Write-Host "â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•`n" -ForegroundColor Yellow

$issuesFound = @()

if ($needsInterfaceFix) {
    $issuesFound += "Missing firewall rule to allow VPN interface traffic"
}

if ($needsRoutingFix) {
    $issuesFound += "VPN is not the default gateway"
}

if ($vpnAdapter.Status -ne "Up") {
    $issuesFound += "VPN interface is down"
}

if (-not $vpnIP) {
    $issuesFound += "No IP address on VPN interface"
}

if ($issuesFound.Count -eq 0) {
    Write-OK "No major issues detected!"
    Write-Info "If traffic is still blocked, try the following:"
    Write-Info "  1. Disconnect and reconnect VPN"
    Write-Info "  2. Disable kill switch temporarily"
    Write-Info "  3. Check WireGuard configuration file"
} else {
    Write-Host "Issues found:" -ForegroundColor Yellow
    foreach ($issue in $issuesFound) {
        Write-Host "  âŒ $issue" -ForegroundColor Red
    }
}

if ($DiagnoseOnly) {
    Write-Host "`nDiagnosis complete (no fixes applied)" -ForegroundColor Cyan
    Read-Host "Press Enter to exit"
    exit 0
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# FIX OPERATIONS
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

if ($RemoveAllRules) {
    Write-Host "`n========================================================" -ForegroundColor Red
    Write-Host "         REMOVE ALL NEBULA VPN RULES                   " -ForegroundColor Red
    Write-Host "========================================================`n" -ForegroundColor Red
    
    Write-Warn "This will remove ALL Nebula VPN firewall rules"
    Write-Warn "Kill switch protection will be DISABLED"
    $confirm = Read-Host "Continue? (yes/no)"
    
    if ($confirm -eq "yes") {
        Write-Step "Removing all Nebula VPN firewall rules..."
        
        foreach ($rule in $nebulaRules) {
            try {
                Remove-NetFirewallRule -Name $rule.Name -ErrorAction Stop
                Write-OK "Removed: $($rule.Name)"
            } catch {
                Write-Error "Failed to remove $($rule.Name): $($_.Exception.Message)"
            }
        }
        
        Write-OK "All rules removed. You can now reconnect VPN to recreate them."
    } else {
        Write-Info "Cancelled"
    }
    
    Read-Host "Press Enter to exit"
    exit 0
}

if ($FixAll -or $issuesFound.Count -gt 0) {
    Write-Host "`nâ•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—" -ForegroundColor Green
    Write-Host "â•‘                      APPLYING FIXES                     â•‘" -ForegroundColor Green
    Write-Host "â•šâ•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•`n" -ForegroundColor Green
    
    # FIX 1: Add missing interface allow rule
    if ($needsInterfaceFix) {
        Write-Step "Adding firewall rule to allow VPN interface traffic..."
        
        try {
            # Check if rule already exists (maybe with different name)
            $existing = Get-NetFirewallRule -Name "NebulaVPN-AllowVPNInterface" -ErrorAction SilentlyContinue
            
            if ($existing) {
                Write-Info "Rule already exists, updating..."
                Set-NetFirewallRule -Name "NebulaVPN-AllowVPNInterface" `
                    -Enabled True `
                    -Action Allow `
                    -ErrorAction Stop
            } else {
                New-NetFirewallRule `
                    -Name "NebulaVPN-AllowVPNInterface" `
                    -DisplayName "Nebula VPN - Allow Interface Traffic" `
                    -Description "Allows all traffic through the VPN tunnel interface" `
                    -Direction Outbound `
                    -Action Allow `
                    -InterfaceAlias $vpnName `
                    -Enabled True `
                    -Profile Any `
                    -ErrorAction Stop | Out-Null
            }
            
            Write-OK "Firewall rule created/updated successfully"
        } catch {
            Write-Error "Failed to create firewall rule: $($_.Exception.Message)"
        }
    }
    
    # FIX 2: Ensure VPN interface routing priority
    if ($needsRoutingFix) {
        Write-Step "Adjusting routing priority..."
        Write-Info "WireGuard should handle this via AllowedIPs = 0.0.0.0/0"
        Write-Info "Check your WireGuard configuration file"
    }
    
    # FIX 3: Flush DNS cache
    Write-Step "Flushing DNS cache..."
    try {
        ipconfig /flushdns | Out-Null
        Write-OK "DNS cache flushed"
    } catch {
        Write-Warn "Failed to flush DNS cache"
    }
    
    Write-Host "`nâœ… Fixes applied!" -ForegroundColor Green
    Write-Info "Test your connection now"
}

# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
# TESTING SUGGESTIONS
# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

Write-Host "`nâ•”â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•—" -ForegroundColor Cyan
Write-Host "â•‘                    TEST YOUR VPN                        â•‘" -ForegroundColor Cyan
